# On the server: copy to config/.smartCourse.env, chmod 600. Never commit the filled file.
# Compose supplies the production origin, port, Mongo host/name, Redis URL and app identity.
# Use a dedicated Mongo user with readWrite on smartcourse, created in the smartcourse database.
SMARTCOURSE_DB_USER=
SMARTCOURSE_DB_PASSWORD=
SMARTCOURSE_DB_AUTH_SOURCE=smartcourse
SMARTCOURSE_BAILIAN_APP_ID=91992812fcd04fe3b696d957cc50e3f8
SMARTCOURSE_BAILIAN_API_KEY=
SMARTCOURSE_AGENT_VERSION=qinghua-v1
SMARTCOURSE_OSS_REGION=oss-cn-wulanchabu
SMARTCOURSE_OSS_BUCKET=image-miniapp001
SMARTCOURSE_OSS_ACCESS_KEY_ID=
SMARTCOURSE_OSS_ACCESS_KEY_SECRET=

# Reuse Mandis OSS credentials; keep smartCourse objects in this separate prefix.
SMARTCOURSE_OSS_WORKS_PREFIX=smart/user_upload/works
